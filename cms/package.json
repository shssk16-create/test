{
  "name": "cloudflare-cms",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:worker": "wrangler dev worker/index.ts",
    "dev:admin": "astro dev --root admin",
    "build:admin": "astro build --root admin",
    "db:generate": "npx tsx scripts/generate-migration.ts",
    "db:seed": "npx tsx scripts/seed.ts",
    "db:migrate": "wrangler d1 migrations apply cms-db --local"
  },
  "dependencies": {
    "hono": "^4.6.1",
    "@hono/zod-validator": "^0.4.1",
    "zod": "^3.23.8",
    "astro": "^5.0.0",
    "@astrojs/react": "^4.0.0",
    "@astrojs/cloudflare": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@tiptap/react": "^2.10.3",
    "@tiptap/starter-kit": "^2.10.3",
    "wrangler": "^3.90.0"
  }
}
